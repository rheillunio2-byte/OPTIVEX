<Window x:Class="OPTIVEX.App.DialogWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
 SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 MinWidth="400" MaxWidth="600" MaxHeight="640" FontFamily="Segoe UI Variable Text, Segoe UI"
 AutomationProperties.Name="OPTIVEX dialog">
 <Border Style="{StaticResource Card}" Margin="18" Background="{StaticResource PanelBrush}">
  <Border.Effect><DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.65" Color="Black"/></Border.Effect>
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <!-- header (drag to move) -->
   <Border Grid.Row="0" Background="Transparent" Padding="22,18,22,6" MouseLeftButtonDown="Header_MouseDown">
    <StackPanel Orientation="Horizontal">
     <TextBlock x:Name="KindGlyph" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.Name="Dialog type"/>
     <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitle}" FontSize="18" TextWrapping="Wrap" VerticalAlignment="Center"/>
    </StackPanel>
   </Border>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="400" Margin="22,6,22,6">
    <TextBlock x:Name="MessageText" Foreground="{StaticResource TextSoftBrush}" FontSize="13" TextWrapping="Wrap" LineHeight="20"/>
   </ScrollViewer>
   <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="22,14,22,20">
    <Button x:Name="SecondaryButton" Style="{StaticResource SecondaryButton}" MinWidth="96" Margin="0,0,10,0" Click="Secondary_Click"/>
    <Button x:Name="PrimaryButton" MinWidth="96" Click="Primary_Click"/>
   </StackPanel>
  </Grid>
 </Border>
</Window>
