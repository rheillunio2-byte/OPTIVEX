       <StackPanel Margin="0,0,10,10"><TextBlock Text="Minimum GPU" Style="{StaticResource Caption}" Margin="0,0,0,4"/><TextBox Style="{StaticResource DarkTextBox}" Text="{Binding NewMinGpu, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Margin="0,0,10,10"><TextBlock Text="Recommended GPU" Style="{StaticResource Caption}" Margin="0,0,0,4"/><TextBox Style="{StaticResource DarkTextBox}" Text="{Binding NewRecGpu, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
       <StackPanel Margin="0,0,10,10"><TextBlock Text="Minimum RAM (GB)" Style="{StaticResource Caption}" Margin="0,0,0,4"/><TextBox Style="{StaticResource DarkTextBox}" Text="{Binding NewMinRam, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Margin="0,0,10,10"><TextBlock Text="Recommended RAM (GB)" Style="{StaticResource Caption}" Margin="0,0,0,4"/><TextBox Style="{StaticResource DarkTextBox}" Text="{Binding NewRecRam, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
       <StackPanel Margin="0,0,10,10"><TextBlock Text="Storage needed (GB)" Style="{StaticResource Caption}" Margin="0,0,0,4"/><TextBox Style="{StaticResource DarkTextBox}" Text="{Binding NewStorage, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Margin="0,0,10,10"><TextBlock Text="Windows (e.g. Windows 10 64-bit)" Style="{StaticResource Caption}" Margin="0,0,0,4"/><TextBox Style="{StaticResource DarkTextBox}" Text="{Binding NewOs, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
      </ctl:AdaptivePanel>
      <StackPanel Margin="0,0,10,10"><TextBlock Text="Where you found this (page or note, optional)" Style="{StaticResource Caption}" Margin="0,0,0,4"/><TextBox Style="{StaticResource DarkTextBox}" Text="{Binding NewSourceNote, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
      <DockPanel><Button DockPanel.Dock="Left" Content="Add game" Command="{Binding AddGameCommand}" Margin="0,0,12,0"/>
       <TextBlock Text="{Binding AddStatus}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
     </StackPanel>
    </Border></ScrollViewer>
   </Grid>
  </Grid>
 </DataTemplate>

 <!-- ================= Game Compatibility ================= -->
 <DataTemplate DataType="{x:Type vm:GameCompatibilityViewModel}">
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <DockPanel Grid.Column="0" Margin="0,0,16,0">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
     <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search for a game"/>
     <TextBlock Text="{Binding ResultCountText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="2,6,0,0"/>
    </StackPanel>
    <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedGame, Mode=TwoWay}" Background="{StaticResource PanelBrush}" BorderThickness="0"
             ItemContainerStyle="{StaticResource DarkListItem}" Padding="6">
     <ListBox.ItemTemplate><DataTemplate><StackPanel>
      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding OriginLabel}" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>

   <Grid Grid.Column="1">
    <TextBlock Text="Search and select a game to compare it with your PC." VerticalAlignment="Top" Margin="4,10,0,0">
     <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Style.Triggers><DataTrigger Binding="{Binding HasSelection}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers><DataTrigger Binding="{Binding HasSelection}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
     <StackPanel>
      <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,10">
       <StackPanel>
        <TextBlock Text="{Binding SelectedGame.Title}" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/>
        <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap"><Run Text="{Binding OriginText, Mode=OneWay}" Foreground="{StaticResource CyanBrush}"/><Run Text="  ·  "/><Run Text="{Binding VerifiedText, Mode=OneWay}"/></TextBlock>
        <TextBlock Text="{Binding SourceText, StringFormat='Source: {0}'}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
        <TextBlock Text="{Binding HardwareText, StringFormat='Your PC: {0}'}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"/>
       </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,10">
       <StackPanel><TextBlock Text="RESULT" Style="{StaticResource MetricLabel}"/>
        <TextBlock Text="{Binding VerdictText}" FontSize="24" FontWeight="Bold" Margin="0,6,0,0" Foreground="{Binding VerdictLevel, Converter={StaticResource HealthBrush}}"/></StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,10">
       <StackPanel><TextBlock Text="Published requirements" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <TextBlock Grid.Column="1" Text="MINIMUM" Style="{StaticResource MetricLabel}"/><TextBlock Grid.Column="2" Text="RECOMMENDED" Style="{StaticResource MetricLabel}"/></Grid>
        <ItemsControl ItemsSource="{Binding Requirements}"><ItemsControl.ItemTemplate><DataTemplate>
         <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedBrush}"/><TextBlock Grid.Column="1" Text="{Binding Minimum}" TextWrapping="Wrap" Margin="0,0,10,0"/>
          <TextBlock Grid.Column="2" Text="{Binding Recommended}" TextWrapping="Wrap"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,10">
       <StackPanel>
        <TextBlock Text="Your assessment of CPU and GPU" FontWeight="SemiBold"/>
        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,8"
         Text="Processor and graphics models can't be compared reliably by name, so OPTIVEX asks you to judge them against the listed models. It never guesses."/>
        <TextBlock Text="Processor" Style="{StaticResource Caption}"/><StackPanel Orientation="Horizontal" Margin="0,4,0,0"><Button Content="Not sure" Command="{Binding SetCpuLevelCommand}" CommandParameter="NotSure" Margin="0,0,6,0" Padding="10,6" Background="{Binding CpuLevel, Converter={StaticResource ModeBrush}, ConverterParameter=NotSure}"/><Button Content="Below minimum" Command="{Binding SetCpuLevelCommand}" CommandParameter="Below" Margin="0,0,6,0" Padding="10,6" Background="{Binding CpuLevel, Converter={StaticResource ModeBrush}, ConverterParameter=Below}"/><Button Content="Meets minimum" Command="{Binding SetCpuLevelCommand}" CommandParameter="Min" Margin="0,0,6,0" Padding="10,6" Background="{Binding CpuLevel, Converter={StaticResource ModeBrush}, ConverterParameter=Min}"/><Button Content="Meets recommended" Command="{Binding SetCpuLevelCommand}" CommandParameter="Rec" Margin="0,0,6,0" Padding="10,6" Background="{Binding CpuLevel, Converter={StaticResource ModeBrush}, ConverterParameter=Rec}"/></StackPanel>
        <TextBlock Text="Graphics" Style="{StaticResource Caption}" Margin="0,10,0,0"/><StackPanel Orientation="Horizontal" Margin="0,4,0,0"><Button Content="Not sure" Command="{Binding SetGpuLevelCommand}" CommandParameter="NotSure" Margin="0,0,6,0" Padding="10,6" Background="{Binding GpuLevel, Converter={StaticResource ModeBrush}, ConverterParameter=NotSure}"/><Button Content="Below minimum" Command="{Binding SetGpuLevelCommand}" CommandParameter="Below" Margin="0,0,6,0" Padding="10,6" Background="{Binding GpuLevel, Converter={StaticResource ModeBrush}, ConverterParameter=Below}"/><Button Content="Meets minimum" Command="{Binding SetGpuLevelCommand}" CommandParameter="Min" Margin="0,0,6,0" Padding="10,6" Background="{Binding GpuLevel, Converter={StaticResource ModeBrush}, ConverterParameter=Min}"/><Button Content="Meets recommended" Command="{Binding SetGpuLevelCommand}" CommandParameter="Rec" Margin="0,0,6,0" Padding="10,6" Background="{Binding GpuLevel, Converter={StaticResource ModeBrush}, ConverterParameter=Rec}"/></StackPanel>
       </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,10">
       <StackPanel><TextBlock Text="Component by component" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <ItemsControl ItemsSource="{Binding Checks}"><ItemsControl.ItemTemplate><DataTemplate>
         <StackPanel Margin="0,5"><TextBlock FontWeight="SemiBold"><Run Text="{Binding Icon, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Component, Mode=OneWay}"/></TextBlock>
          <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="22,2,0,0"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <TextBlock Text="✔ met   ✖ not met   ? needs your input   – not published by the source" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,8,0,0"/>
       </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,10">
       <StackPanel><TextBlock Text="Please note" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <ItemsControl ItemsSource="{Binding Limitations}"><ItemsControl.ItemTemplate><DataTemplate>
         <TextBlock Text="{Binding StringFormat='•  {0}'}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <TextBlock Text="{Binding NotesText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/>
       </StackPanel>
      </Border>
     </StackPanel>
    </ScrollViewer>
   </Grid>
  </Grid>
 </DataTemplate>

 <!-- ================= Laptop Care ================= -->
 <DataTemplate DataType="{x:Type vm:LaptopCareViewModel}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
   <StackPanel>
    <DockPanel Margin="0,0,0,12">
     <Button DockPanel.Dock="Right" Content="Create Windows battery report" Command="{Binding CreateReportCommand}" Style="{StaticResource SecondaryButton}" ToolTip="Asks Windows to write its own battery report; nothing is changed or deleted"/>
     <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap"/>
    </DockPanel>

    <Border Padding="18" Margin="0,0,0,12">
     <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasBattery}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
     <StackPanel><TextBlock Text="No battery detected" FontSize="16" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding NoBatteryReason}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
      <TextBlock Text="Power plan and temperature readings below still apply." Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel>
    </Border>

    <StackPanel>
     <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasBattery}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
     <TextBlock Text="{Binding BatteryName}" Style="{StaticResource Caption}" Margin="2,0,0,8"/>
     <ctl:AdaptivePanel MinItemWidth="170">
      <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,10,10"><StackPanel><TextBlock Text="CHARGE" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding ChargeText}" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="{Binding ChargeNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,10,10"><StackPanel><TextBlock Text="BATTERY HEALTH" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding HealthText}" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0" Foreground="{Binding BatteryHealthLevel, Converter={StaticResource HealthBrush}}"/><TextBlock Text="{Binding HealthNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,10,10"><StackPanel><TextBlock Text="DESIGN CAPACITY" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding DesignText}" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="{Binding DesignNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,10,10"><StackPanel><TextBlock Text="FULL-CHARGE CAPACITY" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding FullText}" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="{Binding FullNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,10,10"><StackPanel><TextBlock Text="CYCLE COUNT" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding CycleText}" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="{Binding CycleNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
     </ctl:AdaptivePanel>
    </StackPanel>

    <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12">
     <StackPanel><TextBlock Text="POWER PLAN" Style="{StaticResource MetricLabel}"/>
      <TextBlock Text="{Binding PowerPlanName}" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,4"/>
      <TextBlock Text="{Binding PowerPlanAdvice}" TextWrapping="Wrap" FontSize="12"/></StackPanel>
    </Border>

    <ctl:AdaptivePanel MinItemWidth="380">
     <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,10,10"><StackPanel><TextBlock Text="CPU TEMPERATURE" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding CpuTempText}" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0" Foreground="{Binding CpuTempLevel, Converter={StaticResource HealthBrush}}"/><TextBlock Text="{Binding CpuTempNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,10,10"><StackPanel><TextBlock Text="GPU TEMPERATURE" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding GpuTempText}" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0" Foreground="{Binding GpuTempLevel, Converter={StaticResource HealthBrush}}"/><TextBlock Text="{Binding GpuTempNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
    </ctl:AdaptivePanel>

    <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12">
     <StackPanel>
      <TextBlock Text="Recommendations for this laptop" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
      <ItemsControl ItemsSource="{Binding Recommendations}"/>
      <StackPanel Margin="0,4,0,0">
       <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers><DataTrigger Binding="{Binding HasNotAssessed}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
       <TextBlock Text="NOT ASSESSED (could not be read on this PC)" Style="{StaticResource MetricLabel}"/>
       <ItemsControl ItemsSource="{Binding NotAssessed}"><ItemsControl.ItemTemplate><DataTemplate>
        <TextBlock Text="{Binding StringFormat='•  {0}'}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
     </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12">
     <StackPanel>
      <TextBlock Text="General laptop care (not specific to your readings)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSoftBrush}" FontSize="12" LineHeight="20"
       Text="•  Keep air vents clear and use the laptop on a hard, flat surface. Heat is hard on both components and batteries.&#10;•  If your manufacturer offers a battery-care or charge-limit mode, it can reduce wear when you are mostly plugged in.&#10;•  Brush or blow dust from vents gently every so often, with the laptop off and unplugged.&#10;•  Avoid leaving the laptop in a hot car or in direct sun."/>
     </StackPanel>
    </Border>
    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="2,0,0,10"
      Text="Battery figures come from Windows and the battery's own firmware, so they can be imperfect. Temperature support varies by hardware and may need administrator rights. OPTIVEX shows &quot;Unavailable&quot; rather than a guess."/>
   </StackPanel>
  </ScrollViewer>
 </DataTemplate>

 <!-- ================= Reports ================= -->
 <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Grid.Row="0" Margin="0,0,0,10">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <Button Content="Export text (.txt)" Command="{Binding ExportTextCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" ToolTip="Saves a readable report of all history"/>
     <Button Content="Export table (.csv)" Command="{Binding ExportCsvCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" ToolTip="Saves the table you are viewing, for Excel"/>
     <Button Content="Print / save as PDF" Command="{Binding PrintReportCommand}" Style="{StaticResource SecondaryButton}" ToolTip="Opens the print dialog. Choose Microsoft Print to PDF to save a PDF"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal">
     <Button Content="System scans" Command="{Binding SetModeCommand}" CommandParameter="System" Margin="0,0,8,0" Background="{Binding Mode, Converter={StaticResource ModeBrush}, ConverterParameter=System}"/><Button Content="Storage scans" Command="{Binding SetModeCommand}" CommandParameter="Storage" Margin="0,0,8,0" Background="{Binding Mode, Converter={StaticResource ModeBrush}, ConverterParameter=Storage}"/><Button Content="Cleanups" Command="{Binding SetModeCommand}" CommandParameter="Cleanups" Margin="0,0,8,0" Background="{Binding Mode, Converter={StaticResource ModeBrush}, ConverterParameter=Cleanups}"/><Button Content="Actions" Command="{Binding SetModeCommand}" CommandParameter="Actions" Margin="0,0,8,0" Background="{Binding Mode, Converter={StaticResource ModeBrush}, ConverterParameter=Actions}"/><Button Content="Analyses" Command="{Binding SetModeCommand}" CommandParameter="Analyses" Margin="0,0,8,0" Background="{Binding Mode, Converter={StaticResource ModeBrush}, ConverterParameter=Analyses}"/>
    </StackPanel>
   </DockPanel>
   <StackPanel Grid.Row="1" Margin="2,0,0,8">
    <TextBlock Text="{Binding HistoryNote}" Foreground="{StaticResource WarnBrush}" FontSize="11" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
   </StackPanel>

   <Grid Grid.Row="2"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers><DataTrigger Binding="{Binding Mode}" Value="System"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,0,10"><Grid>
     <DataGrid ItemsSource="{Binding SystemRows}" SelectedItem="{Binding SelectedScan, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single" Background="Transparent" RowBackground="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" ColumnHeaderStyle="{StaticResource DarkHeader}" CellStyle="{StaticResource DarkCell}">
      <DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="150"/><DataGridTextColumn Header="Windows" Binding="{Binding Windows}" Width="*"/><DataGridTextColumn Header="Memory" Binding="{Binding Memory}" Width="190"/><DataGridTextColumn Header="Drives" Binding="{Binding Drives}" Width="2*"/></DataGrid.Columns>
     </DataGrid><TextBlock Text="Nothing recorded yet. Run a scan or analysis and it will appear here." HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="20"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SystemCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border>
    <Border Style="{StaticResource Card}" Grid.Row="1" Padding="16" MaxHeight="250">
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock Text="{Binding ComparisonTitle}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
      <ItemsControl ItemsSource="{Binding Comparison}"><ItemsControl.ItemTemplate><DataTemplate>
       <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,8,0"/>
        <TextBlock Grid.Column="1" Text="{Binding Before}" TextWrapping="Wrap" Margin="0,0,8,0"/>
        <TextBlock Grid.Column="2" Text="{Binding After}" TextWrapping="Wrap" Margin="0,0,8,0"/>
        <TextBlock Grid.Column="3" Text="{Binding Change}" Foreground="{StaticResource CyanBrush}" TextWrapping="Wrap"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"
       Text="Differences only: OPTIVEX does not judge them. Memory in use depends on what was running when each scan was taken."/>
     </StackPanel></ScrollViewer>
    </Border>
   </Grid>

   <Grid Grid.Row="2"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers><DataTrigger Binding="{Binding Mode}" Value="Storage"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style><Border Style="{StaticResource Card}" Padding="8"><Grid><DataGrid ItemsSource="{Binding StorageRows}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single" Background="Transparent" RowBackground="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" ColumnHeaderStyle="{StaticResource DarkHeader}" CellStyle="{StaticResource DarkCell}"><DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="150"/><DataGridTextColumn Header="Files found" Binding="{Binding Files}" Width="110"/><DataGridTextColumn Header="Total size" Binding="{Binding Size}" Width="110"/><DataGridTextColumn Header="Categories" Binding="{Binding Note}" Width="*"/></DataGrid.Columns></DataGrid><TextBlock Text="Nothing recorded yet. Run a scan or analysis and it will appear here." HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="20"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding StorageCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border></Grid>
   <Grid Grid.Row="2"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers><DataTrigger Binding="{Binding Mode}" Value="Cleanups"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style><Border Style="{StaticResource Card}" Padding="8"><Grid><DataGrid ItemsSource="{Binding CleanupRows}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single" Background="Transparent" RowBackground="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" ColumnHeaderStyle="{StaticResource DarkHeader}" CellStyle="{StaticResource DarkCell}"><DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="150"/><DataGridTextColumn Header="Files selected" Binding="{Binding Selected}" Width="130"/><DataGridTextColumn Header="Deleted" Binding="{Binding Deleted}" Width="110"/><DataGridTextColumn Header="Space recovered" Binding="{Binding Recovered}" Width="150"/><DataGridTextColumn Header="Skipped" Binding="{Binding Skipped}" Width="*"/></DataGrid.Columns></DataGrid><TextBlock Text="Nothing recorded yet. Run a scan or analysis and it will appear here." HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="20"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CleanupCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border></Grid>
   <Grid Grid.Row="2"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers><DataTrigger Binding="{Binding Mode}" Value="Actions"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style><Border Style="{StaticResource Card}" Padding="8"><Grid><DataGrid ItemsSource="{Binding ActionRows}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single" Background="Transparent" RowBackground="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" ColumnHeaderStyle="{StaticResource DarkHeader}" CellStyle="{StaticResource DarkCell}"><DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="150"/><DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="200"/><DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="*"/><DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*"/></DataGrid.Columns></DataGrid><TextBlock Text="Nothing recorded yet. Run a scan or analysis and it will appear here." HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="20"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ActionCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border></Grid>
   <Grid Grid.Row="2"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers><DataTrigger Binding="{Binding Mode}" Value="Analyses"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style><Border Style="{StaticResource Card}" Padding="8"><Grid><DataGrid ItemsSource="{Binding AnalysisRows}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single" Background="Transparent" RowBackground="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" ColumnHeaderStyle="{StaticResource DarkHeader}" CellStyle="{StaticResource DarkCell}"><DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="150"/><DataGridTextColumn Header="Recommendations" Binding="{Binding Count}" Width="130"/><DataGridTextColumn Header="Issues found" Binding="{Binding Issues}" Width="*"/></DataGrid.Columns></DataGrid><TextBlock Text="Nothing recorded yet. Run a scan or analysis and it will appear here." HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="20"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding AnalysisCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border></Grid>
  </Grid>
 </DataTemplate>

 <!-- ================= Settings ================= -->
 <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource CyanBrush}" FontSize="12" TextWrapping="Wrap" Margin="2,0,0,10"/>
   <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12"><StackPanel><TextBlock Text="History" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBlock Text="OPTIVEX can keep a local history of scans, cleanups and actions so you can compare them over time and export reports. It is stored in a database on this PC only. Storage scans keep totals per category, never file names." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"/><StackPanel Margin="0,0,0,14"><TextBlock Text="Save history" FontWeight="SemiBold" Margin="0,0,0,6"/><StackPanel Orientation="Horizontal"><Button Content="On" Command="{Binding SetSaveHistoryCommand}" CommandParameter="On" Margin="0,0,8,0" Background="{Binding SaveHistoryMode, Converter={StaticResource ModeBrush}, ConverterParameter=On}"/><Button Content="Off" Command="{Binding SetSaveHistoryCommand}" CommandParameter="Off" Margin="0,0,8,0" Background="{Binding SaveHistoryMode, Converter={StaticResource ModeBrush}, ConverterParameter=Off}"/></StackPanel></StackPanel><StackPanel Margin="0,0,0,14"><TextBlock Text="Keep history for" FontWeight="SemiBold" Margin="0,0,0,6"/><StackPanel Orientation="Horizontal"><Button Content="30 days" Command="{Binding SetRetentionCommand}" CommandParameter="30" Margin="0,0,8,0" Background="{Binding RetentionMode, Converter={StaticResource ModeBrush}, ConverterParameter=30}"/><Button Content="90 days" Command="{Binding SetRetentionCommand}" CommandParameter="90" Margin="0,0,8,0" Background="{Binding RetentionMode, Converter={StaticResource ModeBrush}, ConverterParameter=90}"/><Button Content="1 year" Command="{Binding SetRetentionCommand}" CommandParameter="365" Margin="0,0,8,0" Background="{Binding RetentionMode, Converter={StaticResource ModeBrush}, ConverterParameter=365}"/><Button Content="Forever" Command="{Binding SetRetentionCommand}" CommandParameter="0" Margin="0,0,8,0" Background="{Binding RetentionMode, Converter={StaticResource ModeBrush}, ConverterParameter=0}"/></StackPanel></StackPanel><Button Content="Clear all history…" Command="{Binding ClearHistoryCommand}" Style="{StaticResource DangerButton}" HorizontalAlignment="Left" ToolTip="Asks for confirmation first"/></StackPanel></Border>
   <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12"><StackPanel><TextBlock Text="Live monitoring" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/><StackPanel Margin="0,0,0,14"><TextBlock Text="Refresh live pages every" FontWeight="SemiBold" Margin="0,0,0,6"/><StackPanel Orientation="Horizontal"><Button Content="1 second" Command="{Binding SetRefreshCommand}" CommandParameter="1" Margin="0,0,8,0" Background="{Binding RefreshMode, Converter={StaticResource ModeBrush}, ConverterParameter=1}"/><Button Content="2 seconds" Command="{Binding SetRefreshCommand}" CommandParameter="2" Margin="0,0,8,0" Background="{Binding RefreshMode, Converter={StaticResource ModeBrush}, ConverterParameter=2}"/><Button Content="5 seconds" Command="{Binding SetRefreshCommand}" CommandParameter="5" Margin="0,0,8,0" Background="{Binding RefreshMode, Converter={StaticResource ModeBrush}, ConverterParameter=5}"/></StackPanel></StackPanel><TextBlock Text="Applies to System Health, Performance and Gaming Center. Slower refresh uses slightly less CPU. Changes apply the next time you open a page." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"/></StackPanel></Border>
   <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12"><StackPanel><TextBlock Text="Data and privacy" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBlock Text="OPTIVEX does not send anything over the internet. Everything it saves is in the folders below, which you can open and delete at any time." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"/><TextBlock Text="Data folder" Style="{StaticResource Caption}"/><TextBlock Text="{Binding DataFolder}" TextWrapping="Wrap" Margin="0,2,0,8"/><TextBlock Text="Log folder (kept 14 days)" Style="{StaticResource Caption}"/><TextBlock Text="{Binding LogsFolder}" TextWrapping="Wrap" Margin="0,2,0,10"/><StackPanel Orientation="Horizontal"><Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/><Button Content="Open log folder" Command="{Binding OpenLogsFolderCommand}" Style="{StaticResource SecondaryButton}"/></StackPanel></StackPanel></Border>
   <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12"><StackPanel><TextBlock Text="Safety promises" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="20" Foreground="{StaticResource TextSoftBrush}" Text="•  OPTIVEX never deletes personal files, and cleanup only touches a short allow-list of temporary and cache folders after you confirm a preview.&#10;•  It never ends processes, disables Windows services, edits the registry beyond the reversible per-user startup switch, or touches antivirus.&#10;•  Everything it recommends is advice. Nothing is applied automatically.&#10;•  A reading that is unavailable is labelled unavailable, never guessed."/></StackPanel></Border>
   <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12"><StackPanel><TextBlock Text="About" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBlock Text="{Binding VersionText}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Take Control of Your PC." Foreground="{StaticResource CyanBrush}" Margin="0,2,0,8"/><TextBlock TextWrapping="Wrap" Style="{StaticResource Caption}" Text="MIT licensed. Built with .NET 8 and WPF using CommunityToolkit.Mvvm, LiveCharts2, LibreHardwareMonitor, Serilog and SQLite. See docs/THIRD_PARTY_NOTICES.md for licences. This is a release candidate: report anything that looks wrong."/></StackPanel></Border>
  </StackPanel></ScrollViewer>
 </DataTemplate>

