    <Border Style="{StaticResource Card}" Grid.Row="1" Padding="8">
     <DataGrid ItemsSource="{Binding CatalogRows}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single" Background="Transparent" RowBackground="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" ColumnHeaderStyle="{StaticResource DarkHeader}" CellStyle="{StaticResource DarkCell}" HorizontalScrollBarVisibility="Auto">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Game" Binding="{Binding Title}" Width="170"/>
       <DataGridTextColumn Header="Min CPU" Binding="{Binding MinCpu}" Width="190"/>
       <DataGridTextColumn Header="Min GPU" Binding="{Binding MinGpu}" Width="230"/>
       <DataGridTextColumn Header="Min RAM" Binding="{Binding MinRam}" Width="110"/>
       <DataGridTextColumn Header="Rec CPU" Binding="{Binding RecCpu}" Width="190"/>
       <DataGridTextColumn Header="Rec GPU" Binding="{Binding RecGpu}" Width="230"/>
       <DataGridTextColumn Header="Rec RAM" Binding="{Binding RecRam}" Width="90"/>
       <DataGridTextColumn Header="Storage" Binding="{Binding Storage}" Width="80"/>
       <DataGridTextColumn Header="Origin" Binding="{Binding Origin}" Width="120"/>
       <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="260"/>
       <DataGridTextColumn Header="Verified" Binding="{Binding Verified}" Width="100"/>
       <DataGridTemplateColumn Header="" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate>
        <Button Content="Remove" Padding="10,4" Style="{StaticResource SecondaryButton}" IsEnabled="{Binding CanRemove}" CommandParameter="{Binding}" ToolTip="Only games you added can be removed" Command="{Binding DataContext.RemoveGameCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
       </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      </DataGrid.Columns>
     </DataGrid>
    </Border>
   </Grid>

   <!-- Add a game -->
   <Grid Grid.Row="1"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers><DataTrigger Binding="{Binding Mode}" Value="AddGame"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource Card}" Padding="20">
     <StackPanel>
      <TextBlock Text="Add a game manually" FontSize="16" FontWeight="SemiBold"/>
      <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,14"
