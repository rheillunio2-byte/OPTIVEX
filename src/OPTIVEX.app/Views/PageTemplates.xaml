       <StackPanel Margin="0,0,10,10"><TextBlock Text="Name" Style="{StaticResource Caption}" Margin="0,0,0,4"/><TextBox Style="{StaticResource DarkTextBox}" Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
       <StackPanel Margin="0,0,10,10"><TextBlock Text="Program (.exe, optional)" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
        <DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseProgramCommand}" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Padding="10,6"/>
         <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding NewProfileExe, UpdateSourceTrigger=PropertyChanged}"/></DockPanel></StackPanel>
       <StackPanel Margin="0,0,10,10"><TextBlock Text="Notes (optional)" Style="{StaticResource Caption}" Margin="0,0,0,4"/><TextBox Style="{StaticResource DarkTextBox}" Text="{Binding NewProfileNotes, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
      </ctl:AdaptivePanel>
      <DockPanel><Button DockPanel.Dock="Left" Content="Add profile" Command="{Binding AddProfileCommand}" Margin="0,0,12,0"/>
       <TextBlock Text="{Binding ProfileStatus}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Grid.Row="1" Padding="8">
     <DataGrid ItemsSource="{Binding ProfileRows}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single" Background="Transparent" RowBackground="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" ColumnHeaderStyle="{StaticResource DarkHeader}" CellStyle="{StaticResource DarkCell}">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Game" Binding="{Binding Name}" Width="*"/>
       <DataGridTextColumn Header="Program" Binding="{Binding Program}" Width="2*"/>
       <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
       <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
       <DataGridTemplateColumn Header="" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate>
        <Button Content="Remove" Padding="10,4" Style="{StaticResource SecondaryButton}" CommandParameter="{Binding}" Command="{Binding DataContext.RemoveProfileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
       </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      </DataGrid.Columns>
     </DataGrid>
    </Border>
   </Grid>

   <!-- Catalog -->
   <Grid Grid.Row="1"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers><DataTrigger Binding="{Binding Mode}" Value="Catalog"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,10">
     <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding CatalogQuery, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search by title"/>
     <TextBlock Text="{Binding CatalogNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="2,6,0,0"/>
