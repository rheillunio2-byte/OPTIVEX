     </ctl:AdaptivePanel>
     <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,10">
      <StackPanel><TextBlock Text="GAMES RUNNING NOW" Style="{StaticResource MetricLabel}"/>
       <TextBlock Text="{Binding RunningSummary}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,6"/>
       <ItemsControl ItemsSource="{Binding Running}"><ItemsControl.ItemTemplate><DataTemplate>
        <DockPanel Margin="0,3"><TextBlock DockPanel.Dock="Right" Foreground="{StaticResource CyanBrush}"><Run Text="{Binding Cpu, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Memory, Mode=OneWay}"/></TextBlock>
         <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/></DockPanel>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
     </Border>
     <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,10">
      <StackPanel><TextBlock Text="NOTES FOR YOUR HARDWARE" Style="{StaticResource MetricLabel}"/>
       <ItemsControl ItemsSource="{Binding Tips}" Margin="0,6,0,0"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,5">
        <TextBlock FontWeight="SemiBold" TextWrapping="Wrap"><Run Text="{Binding Icon, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Title, Mode=OneWay}"/></TextBlock>
        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="22,2,0,0"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
     </Border>
    </StackPanel></ScrollViewer>
   </Grid>

   <!-- Profiles -->
   <Grid Grid.Row="1"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers><DataTrigger Binding="{Binding Mode}" Value="Profiles"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,10">
     <StackPanel>
      <TextBlock Text="New game profile" FontWeight="SemiBold" Margin="0,0,0,10"/>
