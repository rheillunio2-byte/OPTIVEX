<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:OPTIVEX.App.ViewModels"
 xmlns:conv="clr-namespace:OPTIVEX.App.Converters"
 xmlns:ctl="clr-namespace:OPTIVEX.App.Controls"
 xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
 <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries>


 <conv:HealthLevelToBrushConverter x:Key="HealthBrush"/>
 <conv:ModeToBrushConverter x:Key="ModeBrush"/>

 <!-- Busy indicator: visible only while the view model reports IsBusy -->
 <Style x:Key="BusyBar" TargetType="ProgressBar">
  <Setter Property="IsIndeterminate" Value="True"/><Setter Property="Height" Value="4"/>
  <Setter Property="Visibility" Value="Collapsed"/><Setter Property="Foreground" Value="{StaticResource CyanBrush}"/>
  <Setter Property="Background" Value="#2A3850"/><Setter Property="BorderThickness" Value="0"/>
  <Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
 </Style>

 <Style x:Key="AnalysisBar" TargetType="ProgressBar" BasedOn="{StaticResource BusyBar}">
  <Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
   <DataTrigger Binding="{Binding IsAnalyzing}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
 </Style>

 <!-- One recommendation: the six spec fields (issue, explanation, benefit, risk, action, reversible) -->
 <DataTemplate DataType="{x:Type vm:RecommendationRow}">
  <Border Style="{StaticResource CardInner}" Padding="14" Margin="0,0,0,10">
   <StackPanel>
    <DockPanel>
     <TextBlock DockPanel.Dock="Right" Text="{Binding Priority}" FontSize="10" FontWeight="Bold" Foreground="{Binding Level, Converter={StaticResource HealthBrush}}"/>
     <TextBlock Text="{Binding Category}" Foreground="{StaticResource CyanBrush}" FontSize="10" FontWeight="Bold"/>
    </DockPanel>
    <TextBlock Text="{Binding Issue}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,6"/>
    <TextBlock Text="{Binding Explanation}" Foreground="{StaticResource TextSoftBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="Potential benefit" Style="{StaticResource Caption}" Margin="0,2"/><TextBlock Grid.Column="1" Text="{Binding Benefit}" FontSize="12" TextWrapping="Wrap" Margin="0,2"/>
     <TextBlock Grid.Row="1" Text="Risk" Style="{StaticResource Caption}" Margin="0,2"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Risk}" FontSize="12" Margin="0,2"/>
     <TextBlock Grid.Row="2" Text="Recommended action" Style="{StaticResource Caption}" Margin="0,2"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Action}" FontSize="12" TextWrapping="Wrap" Margin="0,2"/>
     <TextBlock Grid.Row="3" Text="Reversible" Style="{StaticResource Caption}" Margin="0,2"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Reversible}" FontSize="12" Margin="0,2"/>
    </Grid>
    <Button Style="{StaticResource SecondaryButton}" Content="{Binding GoLabel}" Command="{Binding Go}" HorizontalAlignment="Left" Padding="12,6" Margin="0,10,0,0"
            ToolTip="Opens the page where you can act on this. OPTIVEX changes nothing by itself."/>
   </StackPanel>
  </Border>
 </DataTemplate>

 <!-- ================= Overview ================= -->
 <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
   <StackPanel>
    <DockPanel Margin="0,0,0,14">
     <Button DockPanel.Dock="Right" Content="↻  Scan system" Command="{Binding ScanCommand}" ToolTip="Re-read the hardware inventory"/>
     <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
    </DockPanel>
    <ProgressBar Style="{StaticResource BusyBar}" Margin="0,0,0,14"/>

    <!-- first-run welcome (hidden once dismissed) -->
    <StackPanel>
     <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers><DataTrigger Binding="{Binding ShowWelcome}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
     <Border Style="{StaticResource Card}" BorderBrush="{StaticResource CyanBrush}" Padding="22" Margin="0,0,0,16">
      <DockPanel>
       <Button DockPanel.Dock="Right" Content="Got it" Command="{Binding DismissWelcomeCommand}" VerticalAlignment="Top" Margin="16,0,0,0"/>
       <StackPanel>
        <TextBlock Text="Welcome to OPTIVEX" Style="{StaticResource SectionTitle}" FontSize="18"/>
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSoftBrush}" FontSize="13" LineHeight="21" Margin="0,8,0,0"
         Text="Start with “Analyze my PC” for recommendations based on your real readings. OPTIVEX only advises: it never deletes personal files, ends programs or changes Windows settings without showing you first and asking. Everything stays on this PC. If something can’t be measured, it says so instead of guessing."/>
       </StackPanel>
      </DockPanel>
     </Border>
    </StackPanel>

    <!-- quick actions -->
    <ctl:AdaptivePanel MinItemWidth="230" Margin="0,0,0,6">
     <Button Style="{StaticResource TileButton}" Command="{Binding AnalyzeCommand}" Margin="0,0,10,10" AutomationProperties.Name="Analyze my PC">
      <StackPanel><TextBlock Text="Analyze my PC" Style="{StaticResource SectionTitle}"/><TextBlock Text="Recommendations from your real readings" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Button>
     <Button Style="{StaticResource TileButton}" Command="{Binding OpenCommand}" CommandParameter="Storage Cleaner" Margin="0,0,10,10" AutomationProperties.Name="Free up space">
      <StackPanel><TextBlock Text="Free up space" Style="{StaticResource SectionTitle}"/><TextBlock Text="Review temp files and caches before deleting" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Button>
     <Button Style="{StaticResource TileButton}" Command="{Binding OpenCommand}" CommandParameter="Performance" Margin="0,0,10,10" AutomationProperties.Name="Review startup apps">
      <StackPanel><TextBlock Text="Review startup apps" Style="{StaticResource SectionTitle}"/><TextBlock Text="See what runs at sign-in and what is heavy" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Button>
     <Button Style="{StaticResource TileButton}" Command="{Binding OpenCommand}" CommandParameter="Game Compatibility" Margin="0,0,10,10" AutomationProperties.Name="Check a game">
      <StackPanel><TextBlock Text="Check a game" Style="{StaticResource SectionTitle}"/><TextBlock Text="Compare your PC with published requirements" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Button>
     <Button Style="{StaticResource TileButton}" Command="{Binding OpenCommand}" CommandParameter="Laptop Care" Margin="0,0,10,10" AutomationProperties.Name="Battery and power">
      <StackPanel><TextBlock Text="Battery and power" Style="{StaticResource SectionTitle}"/><TextBlock Text="Battery health, power plan, temperatures" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Button>
    </ctl:AdaptivePanel>
    <ctl:AdaptivePanel MinItemWidth="240" Margin="0,0,0,16">
     <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,12,0">
      <StackPanel><TextBlock Text="PROCESSOR" Style="{StaticResource MetricLabel}"/>
       <TextBlock Text="{Binding CpuName}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0"/>
       <TextBlock Text="{Binding CpuDetail}" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel>
     </Border>
     <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,12,0">
      <StackPanel><TextBlock Text="GRAPHICS" Style="{StaticResource MetricLabel}"/>
       <TextBlock Text="{Binding GpuName}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0"/>
       <TextBlock Text="GPU sensor support varies by device" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel>
     </Border>
     <Border Style="{StaticResource Card}" Padding="18">
      <StackPanel><TextBlock Text="MEMORY" Style="{StaticResource MetricLabel}"/>
       <TextBlock Text="{Binding RamText}" FontSize="22" FontWeight="SemiBold" Margin="0,10,0,0"/>
       <TextBlock Text="{Binding RamDetail}" Style="{StaticResource Caption}" Margin="0,5,0,0"/>
       <ProgressBar Height="6" Maximum="100" Value="{Binding RamPercent, Mode=OneWay}" Background="#2A3850" Foreground="{StaticResource CyanBrush}" BorderThickness="0" Margin="0,10,0,0" AutomationProperties.Name="Memory in use"/></StackPanel>
     </Border>
    </ctl:AdaptivePanel>
    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
     <StackPanel>
      <TextBlock Text="Storage overview (fixed drives)" FontSize="18" FontWeight="SemiBold"/>
      <ItemsControl ItemsSource="{Binding Drives}" Margin="0,14,0,0">
       <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,5">
        <DockPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedBrush}" DockPanel.Dock="Right"/></DockPanel>
        <ProgressBar Height="8" Maximum="100" Value="{Binding UsedPercent, Mode=OneWay}" Background="#2A3850" Foreground="#398BFF" Margin="0,7,0,0"/>
       </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
     <StackPanel>
      <DockPanel>
       <Button DockPanel.Dock="Right" Content="Analyze my PC" Command="{Binding AnalyzeCommand}" ToolTip="Samples your PC for a few seconds, then lists recommendations. Nothing is changed."/>
       <StackPanel>
        <TextBlock Text="Optimization Intelligence" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding AnalysisStatus}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,14,0"/>
       </StackPanel>
      </DockPanel>
      <ProgressBar Style="{StaticResource AnalysisBar}" Margin="0,10,0,0"/>
      <ItemsControl ItemsSource="{Binding Recommendations}" Margin="0,14,0,0"/>
      <StackPanel Margin="0,6,0,0">
       <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers><DataTrigger Binding="{Binding HasNotAssessed}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
       <TextBlock Text="NOT ASSESSED (could not be read on this PC)" Style="{StaticResource MetricLabel}"/>
       <ItemsControl ItemsSource="{Binding NotAssessed}"><ItemsControl.ItemTemplate><DataTemplate>
        <TextBlock Text="{Binding StringFormat='•  {0}'}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
     </StackPanel>
    </Border>
    <TextBlock Text="Temperatures, GPU utilization, battery health and FPS depend on hardware and drivers. OPTIVEX does not invent unavailable readings."
               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="2,4,0,10"/>
   </StackPanel>
  </ScrollViewer>
 </DataTemplate>

 <!-- ================= System Health ================= -->
 <DataTemplate DataType="{x:Type vm:SystemHealthViewModel}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
   <StackPanel>
    <DockPanel Margin="0,0,0,12">
     <Button DockPanel.Dock="Right" Content="↻ Refresh hardware details" Command="{Binding RefreshHardwareCommand}" Style="{StaticResource SecondaryButton}"/>
     <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
    </DockPanel>
    <ctl:AdaptivePanel MinItemWidth="200" Margin="0,0,0,12">
     <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,10,0">
      <StackPanel><TextBlock Text="CPU USAGE" Style="{StaticResource MetricLabel}"/>
       <TextBlock Text="{Binding CpuText}" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,0" Foreground="{Binding CpuLevel, Converter={StaticResource HealthBrush}}"/>
       <TextBlock Text="{Binding CpuNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
     </Border>
     <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,10,0">
      <StackPanel><TextBlock Text="MEMORY" Style="{StaticResource MetricLabel}"/>
       <TextBlock Text="{Binding MemText}" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,0" Foreground="{Binding MemLevel, Converter={StaticResource HealthBrush}}"/>
       <TextBlock Text="{Binding MemNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
     </Border>
     <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,10,0">
      <StackPanel><TextBlock Text="CPU TEMPERATURE" Style="{StaticResource MetricLabel}"/>
       <TextBlock Text="{Binding CpuTempText}" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,0" Foreground="{Binding CpuTempLevel, Converter={StaticResource HealthBrush}}"/>
       <TextBlock Text="{Binding CpuTempNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
     </Border>
     <Border Style="{StaticResource Card}" Padding="16" Margin="0">
      <StackPanel><TextBlock Text="GPU TEMPERATURE" Style="{StaticResource MetricLabel}"/>
       <TextBlock Text="{Binding GpuTempText}" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,0" Foreground="{Binding GpuTempLevel, Converter={StaticResource HealthBrush}}"/>
       <TextBlock Text="{Binding GpuTempNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
     </Border>
    </ctl:AdaptivePanel>
    <ctl:AdaptivePanel MinItemWidth="200" Margin="0,0,0,16">
     <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,10,0"><StackPanel><TextBlock Text="GPU UTILISATION" Style="{StaticResource MetricLabel}"/>
      <TextBlock Text="{Binding GpuLoadText}" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="{Binding GpuLoadNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,10,0"><StackPanel><TextBlock Text="PROCESSES" Style="{StaticResource MetricLabel}"/>
      <TextBlock Text="{Binding ProcessText}" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,10,0"><StackPanel><TextBlock Text="UPTIME" Style="{StaticResource MetricLabel}"/>
      <TextBlock Text="{Binding UptimeText}" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Padding="16"><StackPanel><TextBlock Text="OPTIVEX OVERHEAD" Style="{StaticResource MetricLabel}"/>
      <TextBlock Text="{Binding AppCpuText}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
    </ctl:AdaptivePanel>
    <ctl:AdaptivePanel MinItemWidth="380" Margin="0,0,0,16">
     <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,10,0">
      <StackPanel>
       <DockPanel><TextBlock Text="CPU usage, last 60 s" FontWeight="SemiBold"/>
        <TextBlock DockPanel.Dock="Right" Text="■ System  ■ OPTIVEX" Style="{StaticResource Caption}"/></DockPanel>
       <lvc:CartesianChart Series="{Binding CpuSeries}" XAxes="{Binding TimeAxes}" YAxes="{Binding PercentAxes}" Height="190" Margin="0,8,0,0"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Card}" Padding="16">
      <StackPanel>
       <TextBlock Text="Memory usage, last 60 s" FontWeight="SemiBold"/>
       <lvc:CartesianChart Series="{Binding MemorySeries}" XAxes="{Binding TimeAxes}" YAxes="{Binding PercentAxes}" Height="190" Margin="0,8,0,0"/>
      </StackPanel>
     </Border>
    </ctl:AdaptivePanel>
    <ctl:AdaptivePanel MinItemWidth="380" Margin="0,0,0,10">
     <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,10,0">
      <StackPanel>
       <TextBlock Text="Hardware" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
       <DockPanel Margin="0,4"><TextBlock Text="Processor" Foreground="{StaticResource MutedBrush}" Width="110"/><TextBlock Text="{Binding CpuModel}" TextWrapping="Wrap"/></DockPanel>
       <DockPanel Margin="0,4"><TextBlock Text="Cores" Foreground="{StaticResource MutedBrush}" Width="110"/><TextBlock Text="{Binding CoresText}" TextWrapping="Wrap"/></DockPanel>
       <DockPanel Margin="0,4"><TextBlock Text="Graphics" Foreground="{StaticResource MutedBrush}" Width="110"/><TextBlock Text="{Binding GpuModel}" TextWrapping="Wrap"/></DockPanel>
       <DockPanel Margin="0,4"><TextBlock Text="Memory" Foreground="{StaticResource MutedBrush}" Width="110"/><TextBlock Text="{Binding RamTotalText}" TextWrapping="Wrap"/></DockPanel>
       <DockPanel Margin="0,4"><TextBlock Text="Motherboard" Foreground="{StaticResource MutedBrush}" Width="110"/><TextBlock Text="{Binding BoardText}" TextWrapping="Wrap"/></DockPanel>
       <DockPanel Margin="0,4"><TextBlock Text="Windows" Foreground="{StaticResource MutedBrush}" Width="110"/><TextBlock Text="{Binding OsText}" TextWrapping="Wrap"/></DockPanel>
       <DockPanel Margin="0,4"><TextBlock Text="Architecture" Foreground="{StaticResource MutedBrush}" Width="110"/><TextBlock Text="{Binding ArchText}" TextWrapping="Wrap"/></DockPanel>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Card}" Padding="18">
      <StackPanel>
       <TextBlock Text="Storage (fixed drives)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
       <ItemsControl ItemsSource="{Binding Drives}">
        <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,5">
         <DockPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedBrush}" DockPanel.Dock="Right"/></DockPanel>
         <ProgressBar Height="8" Maximum="100" Value="{Binding UsedPercent, Mode=OneWay}" Background="#2A3850" Foreground="#398BFF" Margin="0,7,0,0"/>
        </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </StackPanel>
     </Border>
    </ctl:AdaptivePanel>
    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="2,0,0,10"
      Text="Colours are OPTIVEX display heuristics, not manufacturer limits. CPU temperature usually needs administrator rights and some hardware never exposes it. OPTIVEX does not self-elevate."/>
   </StackPanel>
  </ScrollViewer>
 </DataTemplate>

 <!-- ================= Storage Cleaner ================= -->
 <DataTemplate DataType="{x:Type vm:StorageCleanerViewModel}">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
    <Button Content="Clean up files" Command="{Binding SetModeCommand}" CommandParameter="Cleanup" Margin="0,0,8,0" Background="{Binding Mode, Converter={StaticResource ModeBrush}, ConverterParameter=Cleanup}"/>
    <Button Content="Large-file analyzer" Command="{Binding SetModeCommand}" CommandParameter="LargeFiles" Margin="0,0,8,0" Background="{Binding Mode, Converter={StaticResource ModeBrush}, ConverterParameter=LargeFiles}"/>
   </StackPanel>

   <!-- ===== Cleanup mode ===== -->
   <Grid Grid.Row="1">
    <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers><DataTrigger Binding="{Binding Mode}" Value="Cleanup"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Style="{StaticResource Card}" Grid.Row="0" Padding="18" Margin="0,0,0,10">
     <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
       <Button Content="Scan" Command="{Binding ScanCommand}" Margin="0,0,8,0" ToolTip="Read-only scan of approved temp and cache folders"/>
       <Button Content="Select all" Command="{Binding SelectAllCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
       <Button Content="Select none" Command="{Binding SelectNoneCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
       <Button Content="Delete selected…" Command="{Binding CleanCommand}" Style="{StaticResource DangerButton}" ToolTip="Shows a preview and asks for confirmation first"/>
      </StackPanel>
      <StackPanel VerticalAlignment="Center">
       <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding TotalText}" Foreground="{StaticResource CyanBrush}" FontSize="12" Margin="0,4,0,0"/>
      </StackPanel>
     </DockPanel>
    </Border>
    <ProgressBar Grid.Row="1" Style="{StaticResource BusyBar}" Margin="0,0,0,8"/>
    <ItemsControl Grid.Row="2" ItemsSource="{Binding Categories}" Margin="0,0,0,8">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate>
      <Border Style="{StaticResource Chip}" Padding="12,8" Margin="0,0,8,8">
       <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" ToolTip="{Binding Description}" VerticalContentAlignment="Center">
        <TextBlock Text="{Binding Label}" Margin="4,0,0,0"/>
       </CheckBox>
      </Border>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <Border Style="{StaticResource Card}" Grid.Row="3" Padding="8">
     <Grid>
      <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single" Background="Transparent" RowBackground="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" ColumnHeaderStyle="{StaticResource DarkHeader}" CellStyle="{StaticResource DarkCell}">
       <DataGrid.Columns>
        <DataGridTemplateColumn Header="Delete?" Width="70" SortMemberPath="IsSelected">
         <DataGridTemplateColumn.CellTemplate><DataTemplate>
          <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
         </DataTemplate></DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="File" Binding="{Binding Name}" Width="*"/>
        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="150"/>
        <DataGridTextColumn Header="Size" Binding="{Binding SizeLabel}" SortMemberPath="SizeBytes" Width="90"/>
        <DataGridTextColumn Header="Modified" Binding="{Binding LastModified, StringFormat=yyyy-MM-dd}" Width="95"/>
        <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="2*"/>
       </DataGrid.Columns>
      </DataGrid>
      <TextBlock Text="No scan results yet." HorizontalAlignment="Center" VerticalAlignment="Center">
       <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Style.Triggers><DataTrigger Binding="{Binding HasItems}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
       </Style></TextBlock.Style>
      </TextBlock>
     </Grid>
    </Border>
    <DockPanel Grid.Row="4" Margin="2,10,0,0">
     <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedText}" Foreground="{StaticResource CyanBrush}"/>
     <TextBlock Text="Only your temp folder, browser caches (Chrome/Edge default profile), shader and internet caches, and crash dumps are listed. Downloads, documents, photos, videos, projects and Windows folders are never scanned."
                Style="{StaticResource Caption}" TextWrapping="Wrap"/>
    </DockPanel>
   </Grid>

   <!-- ===== Large-file analyzer ===== -->
   <Grid Grid.Row="1">
    <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers><DataTrigger Binding="{Binding Mode}" Value="LargeFiles"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
    <Grid DataContext="{Binding LargeFiles}">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Style="{StaticResource Card}" Grid.Row="0" Padding="18" Margin="0,0,0,10">
      <StackPanel>
       <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"/>
       <DockPanel Margin="0,12,0,0">
        <Button DockPanel.Dock="Right" Content="Stop" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
        <TextBlock DockPanel.Dock="Left" Text="Minimum size (MB):" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox DockPanel.Dock="Left" Width="80" Text="{Binding MinSizeMbText, UpdateSourceTrigger=PropertyChanged}" Background="#202D43" Foreground="{StaticResource TextBrush}" CaretBrush="White" BorderBrush="#2A3850" Padding="6,5" Margin="0,0,14,0"/>
        <ItemsControl ItemsSource="{Binding Scopes}">
         <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
         <ItemsControl.ItemTemplate><DataTemplate>
          <Button Content="{Binding DisplayName, StringFormat='Scan {0}'}" CommandParameter="{Binding}"
                  Command="{Binding DataContext.ScanCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Margin="0,0,8,4"/>
         </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
       </DockPanel>
      </StackPanel>
     </Border>
     <ProgressBar Grid.Row="1" Style="{StaticResource BusyBar}" Margin="0,0,0,8"/>
     <Border Style="{StaticResource Card}" Grid.Row="2" Padding="8">
      <Grid>
       <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single" Background="Transparent" RowBackground="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" ColumnHeaderStyle="{StaticResource DarkHeader}" CellStyle="{StaticResource DarkCell}">
        <DataGrid.Columns>
         <DataGridTextColumn Header="File" Binding="{Binding Name}" Width="*"/>
         <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="130"/>
         <DataGridTextColumn Header="Size" Binding="{Binding SizeLabel}" SortMemberPath="SizeBytes" Width="90"/>
         <DataGridTextColumn Header="Modified" Binding="{Binding LastModified, StringFormat=yyyy-MM-dd}" Width="95"/>
         <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="2*"/>
         <DataGridTemplateColumn Header="" Width="120">
          <DataGridTemplateColumn.CellTemplate><DataTemplate>
           <Button Content="Show in folder" Padding="10,4" Style="{StaticResource SecondaryButton}" CommandParameter="{Binding}" Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
          </DataTemplate></DataGridTemplateColumn.CellTemplate>
         </DataGridTemplateColumn>
        </DataGrid.Columns>
       </DataGrid>
       <TextBlock Text="No results yet." HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
         <Style.Triggers><DataTrigger Binding="{Binding HasItems}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
        </Style></TextBlock.Style>
       </TextBlock>
      </Grid>
     </Border>
     <TextBlock Grid.Row="3" Margin="2,10,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap"
       Text="Read-only: this tool only lists large files so you can decide. It cannot delete anything. OneDrive/cloud placeholders and Windows system folders are skipped."/>
    </Grid>
   </Grid>
  </Grid>
 </DataTemplate>

 <!-- ================= Performance ================= -->
 <DataTemplate DataType="{x:Type vm:PerformanceViewModel}">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Style="{StaticResource Card}" Grid.Row="0" Padding="16" Margin="0,0,0,10">
    <StackPanel>
     <TextBlock Text="What stands out right now" FontWeight="SemiBold" Margin="0,0,0,6"/>
     <ItemsControl ItemsSource="{Binding Observations}">
      <ItemsControl.ItemTemplate><DataTemplate>
       <StackPanel Margin="0,4">
        <TextBlock FontWeight="SemiBold" TextWrapping="Wrap"><Run Text="{Binding Icon, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Title, Mode=OneWay}"/></TextBlock>
        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="22,2,0,0"/>
       </StackPanel>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </StackPanel>
   </Border>
   <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
    <Button Content="Processes" Command="{Binding SetModeCommand}" CommandParameter="Processes" Margin="0,0,8,0" Background="{Binding Mode, Converter={StaticResource ModeBrush}, ConverterParameter=Processes}"/>
    <Button Content="Startup apps" Command="{Binding SetModeCommand}" CommandParameter="Startup" Margin="0,0,8,0" Background="{Binding Mode, Converter={StaticResource ModeBrush}, ConverterParameter=Startup}"/>
    <Button Content="Power &amp; visual effects" Command="{Binding SetModeCommand}" CommandParameter="Power" Margin="0,0,8,0" Background="{Binding Mode, Converter={StaticResource ModeBrush}, ConverterParameter=Power}"/>
   </StackPanel>

   <!-- ===== Processes ===== -->
   <Grid Grid.Row="2">
    <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers><DataTrigger Binding="{Binding Mode}" Value="Processes"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,8">
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
      <TextBlock Text="Sort by" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <Button Content="CPU" Command="{Binding SetSortCommand}" CommandParameter="CPU" Margin="0,0,6,0" Background="{Binding SortBy, Converter={StaticResource ModeBrush}, ConverterParameter=CPU}"/>
      <Button Content="Memory" Command="{Binding SetSortCommand}" CommandParameter="Memory" Background="{Binding SortBy, Converter={StaticResource ModeBrush}, ConverterParameter=Memory}"/>
     </StackPanel>
     <TextBlock Text="{Binding ProcessSummary}" Style="{StaticResource Caption}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
    </DockPanel>
    <Border Style="{StaticResource Card}" Grid.Row="1" Padding="8">
     <DataGrid ItemsSource="{Binding Processes}" CanUserSortColumns="False" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single" Background="Transparent" RowBackground="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" ColumnHeaderStyle="{StaticResource DarkHeader}" CellStyle="{StaticResource DarkCell}">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Program" Binding="{Binding Name}" Width="2*"/>
       <DataGridTextColumn Header="Instances" Binding="{Binding Instances}" Width="90"/>
       <DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" Width="100"/>
       <DataGridTextColumn Header="Memory" Binding="{Binding Memory}" Width="110"/>
       <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
      </DataGrid.Columns>
     </DataGrid>
    </Border>
   </Grid>

   <!-- ===== Startup ===== -->
   <Grid Grid.Row="2">
    <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers><DataTrigger Binding="{Binding Mode}" Value="Startup"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="{Binding StartupSummary}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <Border Style="{StaticResource Card}" Grid.Row="1" Padding="8">
     <DataGrid ItemsSource="{Binding StartupItems}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single" Background="Transparent" RowBackground="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" ColumnHeaderStyle="{StaticResource DarkHeader}" CellStyle="{StaticResource DarkCell}">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
       <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="*"/>
       <DataGridTextColumn Header="Where" Binding="{Binding Source}" Width="180"/>
       <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="130"/>
       <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="2*"/>
       <DataGridTemplateColumn Header="" Width="100">
        <DataGridTemplateColumn.CellTemplate><DataTemplate>
         <Button Content="{Binding ActionLabel}" Padding="10,4" IsEnabled="{Binding CanToggle}" ToolTip="{Binding ToolTipText}" CommandParameter="{Binding}"
                 Command="{Binding DataContext.ToggleStartupCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
        </DataTemplate></DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
      </DataGrid.Columns>
     </DataGrid>
    </Border>
   </Grid>

   <!-- ===== Power and visual effects ===== -->
   <Grid Grid.Row="2">
    <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers><DataTrigger Binding="{Binding Mode}" Value="Power"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
    <StackPanel>
     <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12">
      <StackPanel>
       <TextBlock Text="ACTIVE POWER PLAN" Style="{StaticResource MetricLabel}"/>
       <TextBlock Text="{Binding PowerName}" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,6"/>
       <TextBlock Text="{Binding PowerAdviceText}" TextWrapping="Wrap"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12">
      <StackPanel>
       <TextBlock Text="VISUAL EFFECTS" Style="{StaticResource MetricLabel}"/>
       <TextBlock Text="{Binding VisualAdviceText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
      </StackPanel>
     </Border>
     <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
       Text="These are advice only. OPTIVEX reads your settings but does not change the power plan, visual effects or any Windows service."/>
    </StackPanel>
   </Grid>
  </Grid>
 </DataTemplate>

 <!-- ================= Gaming Center ================= -->
 <DataTemplate DataType="{x:Type vm:GamingCenterViewModel}">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
